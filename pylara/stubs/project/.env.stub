APP_NAME="__PROJECT_TITLE__"
APP_ENV=local
APP_DEBUG=true
APP_KEY=__APP_KEY__

# SQLite file (relative to the project root). Use :memory: for throw-away data.
DB_DATABASE=storage/database.sqlite

# Sessions: file (storage/sessions) or memory. Lifetime in minutes. Set SESSION_SECURE=true on HTTPS.
SESSION_DRIVER=file
SESSION_LIFETIME=120
