* { box-sizing: border-box; }
body { margin: 0; font-family: system-ui, sans-serif; background: #f6f7f9; color: #1c1f24; }
main { max-width: 640px; margin: 12vh auto; padding: 0 20px; }
h1 { margin-bottom: 4px; }
.muted { color: #6b7280; }
code { background: #e8eaed; padding: 2px 6px; border-radius: 4px; }
@media (prefers-color-scheme: dark) {
  body { background: #0f1115; color: #e8eaed; }
  .muted { color: #9aa0aa; }
  code { background: #232830; }
}
